# Copy this file to .env.docker. Never commit .env.docker.
# Use URL-safe values for database credentials, or update DATABASE_URL with percent-encoding.

WEB_PORT=8080
APP_ORIGIN=http://localhost:8080

POSTGRES_DB=baotuo_mojian
POSTGRES_USER=baotuo
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://baotuo:replace-with-a-long-random-password@postgres:5432/baotuo_mojian

# Keep RAG disabled unless an embedding provider is configured.
RAG_ENABLED=false
RAG_VERBOSE_LOG=false
QDRANT_COLLECTION=ai_novel_chunks_v1
QDRANT_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Configure at least one text model provider, or add keys later in the product settings page.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

ANTHROPIC_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=
