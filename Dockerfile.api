ARG NODE_IMAGE=node:22-bookworm-slim
ARG NODE_BUILD_IMAGE=node:22-bookworm
FROM ${NODE_BUILD_IMAGE} AS base
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV NODE_ENV=development
USER root
# The build image includes Python, make and a compiler; runtime stays on the slim image.
RUN corepack enable
# Official Node images include matching headers; native modules must not redownload them during install.
ENV npm_config_nodedir=/usr/local

FROM base AS deps
WORKDIR /app
RUN rm -rf /app/* /app/.[!.]* /app/..?* || true
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY client/package.json ./client/package.json
COPY server/package.json ./server/package.json
COPY shared/package.json ./shared/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /app
ENV AI_NOVEL_DATABASE_MODE=postgresql
ENV NODE_OPTIONS=--max-old-space-size=4096
COPY shared ./shared
COPY server/package.json server/tsconfig.json server/prisma.config.ts ./server/
COPY server/src ./server/src
RUN pnpm --filter @ai-novel/shared build \
    && pnpm --filter @ai-novel/server prisma:generate \
    && pnpm --filter @ai-novel/server build

FROM base AS prod-deps
WORKDIR /app
RUN rm -rf /app/* /app/.[!.]* /app/..?* || true
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY client/package.json ./client/package.json
COPY server/package.json ./server/package.json
COPY shared/package.json ./shared/package.json
COPY server/prisma.config.ts ./server/prisma.config.ts
COPY server/src/config/database.ts ./server/src/config/database.ts
COPY server/src/prisma ./server/src/prisma
# pnpm 的 inject-workspace-packages 会把 shared 包内容复制进虚拟 store，
# 复制发生在 install 时；若不先放入构建产物，运行期就会解析不到 dist。
COPY --from=build --chown=node:node /app/shared/dist ./shared/dist
ENV AI_NOVEL_DATABASE_MODE=postgresql
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @ai-novel/server prisma:generate

ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS runtime
USER root
WORKDIR /app
ENV NODE_ENV=production
RUN rm -rf /app/* /app/.[!.]* /app/..?* || true \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends openssl fontconfig fonts-noto-cjk ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/server ./server
COPY --from=build --chown=node:node /app/shared ./shared
COPY --chown=node:node infra/docker/api-entrypoint.sh /app/infra/docker/api-entrypoint.sh
RUN mkdir -p /app/storage/generated-images /app/server/storage/generated-media /app/node_modules/.bin \
    && printf '%s\n' '#!/bin/sh' 'exec node /app/server/node_modules/prisma/build/index.js --config /app/server/prisma.config.ts "$@"' > /app/node_modules/.bin/prisma \
    && chmod +x /app/node_modules/.bin/prisma /app/infra/docker/api-entrypoint.sh \
    && chown -R node:node /app/storage /app/server/storage /app/node_modules/.bin/prisma /app/infra
USER node
EXPOSE 3000
ENTRYPOINT ["/app/infra/docker/api-entrypoint.sh"]
