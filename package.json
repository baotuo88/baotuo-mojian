{
  "name": "ai-novel-writing-assistant-v2",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=10.6.0"
  },
  "scripts": {
    "check:deps": "node scripts/check-deps.cjs",
    "check:prisma-parity": "node scripts/check-prisma-schema-parity.cjs",
    "dev": "node scripts/check-deps.cjs && node scripts/run-with-log.cjs --name dev -- pnpm dev:raw",
    "dev:raw": "concurrently \"pnpm dev:shared\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:log": "node scripts/check-deps.cjs && node scripts/run-with-log.cjs --name dev -- pnpm dev:raw",
    "dev:shared": "pnpm --filter @ai-novel/shared dev",
    "dev:server": "pnpm --filter @ai-novel/server dev",
    "dev:server:log": "node scripts/run-with-log.cjs --name server -- pnpm --filter @ai-novel/server dev",
    "dev:client": "pnpm --filter @ai-novel/client dev",
    "dev:site": "pnpm --filter @ai-novel/site dev",
    "dev:client:wait": "node scripts/wait-for-port.cjs --port 3000 && pnpm dev:client",
    "db:migrate": "pnpm --filter @ai-novel/server db:migrate",
    "db:restore": "pnpm --filter @ai-novel/server db:restore",
    "db:prune-snapshots": "pnpm --filter @ai-novel/server db:prune-snapshots",
    "db:seed": "pnpm --filter @ai-novel/server db:seed",
    "db:studio": "pnpm --filter @ai-novel/server db:studio",
    "build": "pnpm --filter @ai-novel/shared build && pnpm --filter @ai-novel/server build && pnpm --filter @ai-novel/client build",
    "build:site": "pnpm --filter @ai-novel/site build",
    "check:docs-manifest": "node scripts/check-docs-manifest.cjs",
    "typecheck": "pnpm --filter @ai-novel/shared build && pnpm --filter @ai-novel/server typecheck && pnpm --filter @ai-novel/client typecheck",
    "test": "pnpm --filter @ai-novel/server test",
    "test:client": "pnpm --filter @ai-novel/client test",
    "test:all": "pnpm --filter @ai-novel/server test:all && pnpm --filter @ai-novel/client test",
    "test:migrations": "bash scripts/test-migrations.sh",
    "lint": "pnpm --filter @ai-novel/shared lint && pnpm --filter @ai-novel/server lint && pnpm --filter @ai-novel/client lint && pnpm lint:eslint",
    "lint:eslint": "eslint client/src",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "pnpm": {
