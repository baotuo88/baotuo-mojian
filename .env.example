# ============================================
# 宝拓墨间 Docker Compose 环境变量模板
# ============================================
# 这个文件供仓库根目录的 compose.yml 读取（env_file: .env）。
# 首次部署：cp .env.example .env，然后至少修改 POSTGRES_PASSWORD。
#
# 本地源码开发请改用 server/.env（参考 server/.env.example），
# 前端可选覆盖参考 client/.env.example。
#
# 注意：
# 1. 数据库密码含 @ : / # ? 等 URL 特殊字符时，必须在 DATABASE_URL 里做百分号编码；
# 2. 模型密钥可以留空，之后在产品内「设置 → 模型供应商」页面录入；
# 3. 部署目录路径请使用纯英文（含中文路径会导致 Docker Buildx 构建中断）。
# ============================================

# --------------------------------------------
# 访问入口
# --------------------------------------------

# 宿主机暴露的 Web 端口，浏览器访问 http://localhost:${WEB_PORT}
WEB_PORT=8080

# 对外访问地址：用于生成回调链接与推送地址，使用域名时改为最终 HTTPS 地址
APP_BASE_URL=http://localhost:8080

# CORS 允许来源（多个用逗号分隔）。Compose 默认同源访问，可留空
CORS_ORIGIN=

# API JSON body 上限，长篇正文较大时保留默认值；公网暴露建议收窄到 5mb
API_JSON_LIMIT=20mb

# --------------------------------------------
# 数据库（PostgreSQL）
# --------------------------------------------
# DATABASE_URL 由 compose.yml 依据下面三个变量自动拼装，无需手写。
# 只在把 API 指向外部数据库时才需要在这里显式覆盖 DATABASE_URL。

POSTGRES_DB=baotuo_mojian
POSTGRES_USER=baotuo
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --------------------------------------------
# 模型供应商（至少配置一个，或稍后在设置页录入）
# --------------------------------------------
# 键名的唯一事实源是 server/src/llm/providers.ts。
# 每个供应商都支持 <NAME>_API_KEY / <NAME>_BASE_URL / <NAME>_MODEL 三个变量。

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

ANTHROPIC_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=

# Ollama 本地部署无需密钥，只需指向本机服务
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# LLM 请求超时（毫秒）
# LLM_REQUEST_TIMEOUT_MS=120000

# --------------------------------------------
# RAG 知识库（可选）
# --------------------------------------------
# 未配置 Embedding 供应商时保持关闭。启用后需要 --profile rag 启动 Qdrant：
#   docker compose --profile rag up -d --build

RAG_ENABLED=false
RAG_VERBOSE_LOG=false
RAG_DEFAULT_TENANT=default

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VERSION=1
EMBEDDING_BATCH_SIZE=64

# QDRANT_URL 由 compose.yml 指向容器内 http://qdrant:6333；
# 使用 Qdrant Cloud 时在这里覆盖并填写 API Key。
# QDRANT_URL=https://your-cluster.us-west-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_novel_chunks_v1
QDRANT_TIMEOUT_MS=120000

# 检索参数
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_VECTOR_CANDIDATES=40
RAG_KEYWORD_CANDIDATES=40
RAG_FINAL_TOP_K=8

# 索引 Worker
RAG_WORKER_POLL_MS=2500
RAG_WORKER_CONCURRENCY=1
RAG_WORKER_MAX_ATTEMPTS=5
RAG_WORKER_RETRY_BASE_MS=5000

# 超时与重试
RAG_HTTP_TIMEOUT_MS=30000
RAG_EMBEDDING_TIMEOUT_MS=30000
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_RETRY_BASE_MS=500

# 检索追踪（性能分析用；query 默认不落库）
RAG_RETRIEVAL_TRACE_SAMPLE_RATE=1.0
RAG_RETRIEVAL_TRACE_RETENTION_DAYS=14
RAG_RETRIEVAL_TRACE_QUERY_PERSIST_MODE=none

# 重排序（需自备 reranker 服务）
RAG_RERANKER_ENABLED=false
# RAG_RERANKER_ENDPOINT=
# RAG_RERANKER_MODEL=bge-reranker-v2-m3

# --------------------------------------------
# 图片资产
# --------------------------------------------
# Compose 默认使用容器内本地存储卷，无需修改。
# 迁移到 S3/MinIO 时才需要下面的变量。
# IMAGE_STORAGE_DRIVER=minio
# IMAGE_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# IMAGE_STORAGE_S3_REGION=us-east-1
# IMAGE_STORAGE_S3_BUCKET=ai-novel-images
# IMAGE_STORAGE_S3_ACCESS_KEY_ID=
# IMAGE_STORAGE_S3_SECRET_ACCESS_KEY=
# IMAGE_STORAGE_S3_FORCE_PATH_STYLE=true
# IMAGE_GENERATION_HTTP_TIMEOUT_MS=300000

# --------------------------------------------
# 功能开关与运行参数
# --------------------------------------------

# 世界观向导 / 可视化 / 关系图谱
WORLD_WIZARD_ENABLED=true
WORLD_VIS_ENABLED=true
WORLD_GRAPH_ENABLED=false

# 每本小说保留的自动版本快照数量（手动快照不计入）
NOVEL_SNAPSHOT_RETENTION_COUNT=10

# 日志保留天数
# AI_NOVEL_LOG_RETENTION_DAYS=14
# AI_NOVEL_LLM_LOG_RETENTION_DAYS=7

# 拆书分析并发
# BOOK_ANALYSIS_MAX_CONCURRENT_TASKS=2

# --------------------------------------------
# 生成强随机密码
# --------------------------------------------
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# --------------------------------------------
